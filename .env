# ✅ مهم: API_URL يشير للـ backend port 5000
# لكن vite.config.js عنده proxy من 3000 -> 5000
# يعني استخدم /api مباشرة (بدون full URL) في dev mode
VITE_API_URL=/api
VITE_BASE_URL=http://localhost:5000

# Environment
VITE_ENV=development

# Moyasar (اختياري - للدفع)
VITE_MOYASAR_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
